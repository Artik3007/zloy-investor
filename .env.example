# ============================================================
# «Злой инвестор» — переменные окружения.
# Скопируй в .env.local и заполни. .env* в .gitignore: ключи не коммитим.
# ============================================================

# Провайдер LLM: anthropic | openai-compatible | mock
# mock — детерминированные ответы без ключа (разработка, тесты, запасной
# вариант на показе). Включается только явно и никогда не подменяет
# реального провайдера молча (раздел 7.2 ТЗ).
LLM_PROVIDER=mock

# Ключ провайдера. Только на сервере, в клиент не попадает и не логируется.
LLM_API_KEY=

# Модель. Например: claude-opus-5 (anthropic) или имя модели у openai-compatible.
LLM_MODEL=claude-opus-5

# Базовый URL — только для LLM_PROVIDER=openai-compatible.
# Пример: https://api.example.com/v1
LLM_BASE_URL=

# Публичный адрес прототипа, для QR (фишка 4). Не секрет, можно коммитить пустым.
# Если пусто — берётся window.location.origin.
NEXT_PUBLIC_APP_URL=

# 1 — включает страницу /dev/pitches со списком тестовых питчей. На проде не ставим.
NEXT_PUBLIC_DEV_TOOLS=0
